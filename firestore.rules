rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isOptionalBoundedString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    // --- Entity Validation Blueprints ---

    function isValidUserAccount(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             isOptionalBoundedString(data, 'phone', 30) &&
             data.notificationsEnabled is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCreatorProfile(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 35 &&
             data.bio is string && data.bio.size() <= 300 &&
             data.creatorCategory is string && data.creatorCategory.size() >= 1 && data.creatorCategory.size() <= 40 &&
             data.avatarUrl is string && data.avatarUrl.size() <= 1000 &&
             data.isDiscoverable is bool &&
             data.realScore is int && data.realScore >= 0 && data.realScore <= 1000000000 &&
             data.postsCount is int && data.postsCount >= 0 && data.postsCount <= 1000000 &&
             data.followersCount is int && data.followersCount >= 0 && data.followersCount <= 1000000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStoryItem(data) {
      return data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorHandle is string && data.authorHandle.size() >= 2 && data.authorHandle.size() <= 35 &&
             data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 1000 &&
             data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 280 &&
             data.accentColorKey is string && data.accentColorKey in ['coral', 'teal', 'cobalt', 'amber', 'violet'] &&
             data.visibility is string && data.visibility in ['public', 'private'] &&
             data.viewsCount is int && data.viewsCount >= 0 && data.viewsCount <= 1000000000 &&
             isOptionalBoundedString(data, 'thumbnailBase64', 60000) &&
             isOptionalBoundedString(data, 'localMediaUri', 1000) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMediaPost(data) {
      return data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorHandle is string && data.authorHandle.size() >= 2 && data.authorHandle.size() <= 35 &&
             data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 1000 &&
             data.mediaType is string && data.mediaType in ['photo', 'reel', 'long_video'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 1000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.mediaUrl is string && data.mediaUrl.size() <= 1000 &&
             data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 36000 &&
             data.audioTrack is string && data.audioTrack.size() <= 100 &&
             data.locationTag is string && data.locationTag.size() <= 80 &&
             data.tags is list && data.tags.size() <= 8 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40)) &&
             data.visibility is string && data.visibility in ['public', 'private'] &&
             data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000000 &&
             data.commentsCount is int && data.commentsCount >= 0 && data.commentsCount <= 100000000 &&
             data.viewsCount is int && data.viewsCount >= 0 && data.viewsCount <= 1000000000 &&
             data.realScorePoints is int && data.realScorePoints >= 0 && data.realScorePoints <= 1000000000 &&
             data.likedByUids is list && data.likedByUids.size() <= 10 &&
             (data.likedByUids.size() == 0 || (data.likedByUids[0] is string && data.likedByUids[0].size() <= 128)) &&
             isOptionalBoundedString(data, 'thumbnailBase64', 60000) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPostComment(data) {
      return data.postId is string && isValidId(data.postId) &&
             data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorHandle is string && data.authorHandle.size() >= 2 && data.authorHandle.size() <= 35 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChatThread(data) {
      return data.initiatorId is string && isValidId(data.initiatorId) &&
             data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 10 &&
             data.participantIds[0] is string && data.participantIds[0].size() <= 128 &&
             data.chatTitle is string && data.chatTitle.size() >= 1 && data.chatTitle.size() <= 80 &&
             data.peerId is string && isValidId(data.peerId) &&
             data.peerName is string && data.peerName.size() >= 1 && data.peerName.size() <= 60 &&
             data.peerHandle is string && data.peerHandle.size() >= 2 && data.peerHandle.size() <= 35 &&
             data.lastMessage is string && data.lastMessage.size() <= 300 &&
             data.lastSenderId is string && isValidId(data.lastSenderId) &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data) {
      return data.chatId is string && isValidId(data.chatId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 10 &&
             data.participantIds[0] is string && data.participantIds[0].size() <= 128 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
             data.messageType is string && data.messageType in ['text', 'photo', 'shared_post', 'call_event'] &&
             data.sharedPostId is string && data.sharedPostId.size() <= 128 &&
             isOptionalBoundedString(data, 'thumbnailBase64', 60000) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCallSession(data) {
      return data.callerId is string && isValidId(data.callerId) &&
             data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 60 &&
             data.receiverId is string && isValidId(data.receiverId) &&
             data.receiverName is string && data.receiverName.size() >= 1 && data.receiverName.size() <= 60 &&
             data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 2 &&
             data.participantIds[0] is string && data.participantIds[0].size() <= 128 &&
             data.callType is string && data.callType in ['audio', 'video'] &&
             data.status is string && data.status in ['ringing', 'connected', 'ended', 'declined'] &&
             data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 86400 &&
             data.isMuted is bool &&
             data.isCameraEnabled is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 1. Private User Account & PII Isolation (/users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'email', 'notificationsEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'phone', 'notificationsEnabled', 'createdAt', 'updatedAt']) &&
                       isValidUserAccount(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserAccount(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'notificationsEnabled', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Public Discoverable Creator Profiles (/profiles/{userId}) — Zero PII
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow get: if isSignedIn() && isValidId(userId) && resource != null && existing().isDiscoverable == true;
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || existing().isDiscoverable == true);

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'handle', 'bio', 'creatorCategory',
                         'avatarUrl', 'isDiscoverable', 'realScore', 'postsCount',
                         'followersCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'handle', 'bio', 'creatorCategory',
                         'avatarUrl', 'isDiscoverable', 'realScore', 'postsCount',
                         'followersCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCreatorProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidCreatorProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Owner updates profile details and own metrics
                         (request.auth.uid == userId &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'displayName', 'handle', 'bio', 'creatorCategory', 'avatarUrl',
                            'isDiscoverable', 'realScore', 'postsCount', 'followersCount', 'updatedAt'
                          ])) ||
                         // Action 2: Community engagement updates discoverable creator Real Score / follower count
                         (existing().isDiscoverable == true &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['realScore', 'followersCount', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 3. Status Stories (/stories/{storyId})
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId) && resource != null && (existing().visibility == 'public' || existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && (existing().visibility == 'public' || existing().authorId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'authorId', 'authorName', 'authorHandle', 'authorAvatarUrl',
                         'caption', 'accentColorKey', 'visibility', 'viewsCount',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'authorId', 'authorName', 'authorHandle', 'authorAvatarUrl',
                         'caption', 'accentColorKey', 'visibility', 'viewsCount',
                         'thumbnailBase64', 'localMediaUri', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidStoryItem(incoming()) &&
                       exists(/databases/$(database)/documents/profiles/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidId(storyId) &&
                       isValidStoryItem(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Owner edits caption or visibility
                         (existing().authorId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'accentColorKey', 'visibility', 'viewsCount', 'updatedAt'])) ||
                         // Action 2: Viewer increments view counter on public story
                         (existing().visibility == 'public' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(storyId) && existing().authorId == request.auth.uid;
    }

    // 4. Unified Media Posts: Photos, Reels & Long Watch Videos (/posts/{postId})
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && resource != null && (existing().visibility == 'public' || existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && (existing().visibility == 'public' || existing().authorId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'authorId', 'authorName', 'authorHandle', 'authorAvatarUrl',
                         'mediaType', 'title', 'caption', 'category', 'mediaUrl',
                         'durationSec', 'audioTrack', 'locationTag', 'tags',
                         'visibility', 'likesCount', 'commentsCount', 'viewsCount',
                         'realScorePoints', 'likedByUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'authorId', 'authorName', 'authorHandle', 'authorAvatarUrl',
                         'mediaType', 'title', 'caption', 'category', 'mediaUrl',
                         'durationSec', 'audioTrack', 'locationTag', 'tags',
                         'visibility', 'likesCount', 'commentsCount', 'viewsCount',
                         'realScorePoints', 'likedByUids', 'thumbnailBase64',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidMediaPost(incoming()) &&
                       exists(/databases/$(database)/documents/profiles/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidMediaPost(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().mediaType == existing().mediaType &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Owner edits post metadata
                         (existing().authorId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'caption', 'category', 'locationTag', 'tags', 'visibility', 'updatedAt'
                          ])) ||
                         // Action 2: Community engagement (like, view, comment count, Real Score points)
                         ((existing().visibility == 'public' || existing().authorId == request.auth.uid) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'likesCount', 'commentsCount', 'viewsCount', 'realScorePoints', 'likedByUids', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().authorId == request.auth.uid;

      // 5. Post Comments Subcollection (/posts/{postId}/comments/{commentId})
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId) && existing().postId == postId;
        allow list: if isSignedIn() && existing().postId == postId;

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().postId == postId &&
                         incoming().authorId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'postId', 'authorId', 'authorName', 'authorHandle', 'text', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'postId', 'authorId', 'authorName', 'authorHandle', 'text', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidPostComment(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId)) &&
                         (get(/databases/$(database)/documents/posts/$(postId)).data.visibility == 'public' ||
                          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);

        allow update: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidPostComment(incoming()) &&
                         existing().authorId == request.auth.uid &&
                         incoming().authorId == existing().authorId &&
                         incoming().postId == existing().postId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && existing().authorId == request.auth.uid;
      }
    }

    // 6. Private Messaging Threads (/chats/{chatId})
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && resource != null && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;

      allow create: if isSignedIn() &&
                       isValidId(chatId) &&
                       incoming().initiatorId == request.auth.uid &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().keys().hasAll([
                         'initiatorId', 'participantIds', 'chatTitle', 'peerId',
                         'peerName', 'peerHandle', 'lastMessage', 'lastSenderId',
                         'messageCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'initiatorId', 'participantIds', 'chatTitle', 'peerId',
                         'peerName', 'peerHandle', 'lastMessage', 'lastSenderId',
                         'messageCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidChatThread(incoming()) &&
                       exists(/databases/$(database)/documents/profiles/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidId(chatId) &&
                       isValidChatThread(incoming()) &&
                       request.auth.uid in existing().participantIds &&
                       incoming().initiatorId == existing().initiatorId &&
                       incoming().participantIds == existing().participantIds &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'chatTitle', 'lastMessage', 'lastSenderId', 'messageCount', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(chatId) && existing().initiatorId == request.auth.uid;

      // 7. Messages Subcollection (/chats/{chatId}/messages/{messageId})
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && request.auth.uid in existing().participantIds;
        allow list: if isSignedIn() && request.auth.uid in existing().participantIds;

        allow create: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         incoming().chatId == chatId &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantIds &&
                         incoming().keys().hasAll([
                           'chatId', 'senderId', 'senderName', 'participantIds',
                           'text', 'messageType', 'sharedPostId', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'chatId', 'senderId', 'senderName', 'participantIds',
                           'text', 'messageType', 'sharedPostId', 'thumbnailBase64',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidChatMessage(incoming()) &&
                         exists(/databases/$(database)/documents/chats/$(chatId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
                         incoming().participantIds == get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;

        allow update: if isSignedIn() &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming()) &&
                         existing().senderId == request.auth.uid &&
                         incoming().senderId == existing().senderId &&
                         incoming().chatId == existing().chatId &&
                         incoming().participantIds == existing().participantIds &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && existing().senderId == request.auth.uid;
      }
    }

    // 8. Voice ("Phone") & Video Calls (/calls/{callId}) with Terminal State Locking
    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && resource != null && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;

      allow create: if isSignedIn() &&
                       isValidId(callId) &&
                       incoming().callerId == request.auth.uid &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().status == 'ringing' &&
                       incoming().keys().hasAll([
                         'callerId', 'callerName', 'receiverId', 'receiverName',
                         'participantIds', 'callType', 'status', 'durationSec',
                         'isMuted', 'isCameraEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'callerId', 'callerName', 'receiverId', 'receiverName',
                         'participantIds', 'callType', 'status', 'durationSec',
                         'isMuted', 'isCameraEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCallSession(incoming()) &&
                       exists(/databases/$(database)/documents/profiles/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidId(callId) &&
                       isValidCallSession(incoming()) &&
                       request.auth.uid in existing().participantIds &&
                       !(existing().status in ['ended', 'declined']) &&
                       incoming().callerId == existing().callerId &&
                       incoming().receiverId == existing().receiverId &&
                       incoming().participantIds == existing().participantIds &&
                       incoming().callType == existing().callType &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Active session state / media controls
                         (incoming().status in ['ringing', 'connected'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'isMuted', 'isCameraEnabled', 'durationSec', 'updatedAt'
                          ])) ||
                         // Action 2: Terminal transition to ended or declined
                         (incoming().status in ['ended', 'declined'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'durationSec', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(callId) && existing().callerId == request.auth.uid;
    }
  }
}
